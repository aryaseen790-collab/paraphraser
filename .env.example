# ---------------------------------------------------------------
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# On Vercel, add the same keys under Project -> Settings -> Environment Variables.
# Never commit .env.local. Only variables prefixed NEXT_PUBLIC_ reach the browser.
# ---------------------------------------------------------------

# --- Server-only secrets (never exposed to the browser) ---

# Claude Console -> API Keys (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Upstash Console -> your Redis database -> REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Dashboard -> Turnstile -> your widget -> Secret key
# For local testing you can use Cloudflare's always-pass test secret:
#   1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Daily spend ceiling in US dollars. When the estimated spend for the current
# UTC day reaches this value, the site shows a friendly "high demand" message
# instead of calling Claude. Keep this below (monthly Console limit / 31).
DAILY_BUDGET_USD=3

# --- Public values (safe to expose; baked into the browser bundle) ---

# Cloudflare Turnstile site key. Local test key that always passes:
#   1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Your site's name and full URL (used for SEO tags, sitemap and Open Graph)
NEXT_PUBLIC_SITE_NAME=Paraphraser
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Ad slots beside the tool. Leave "false" until AdSense approves the site.
NEXT_PUBLIC_ADS_ENABLED=false
# Your AdSense publisher ID, e.g. ca-pub-1234567890123456 (only used when ads are enabled)
NEXT_PUBLIC_ADSENSE_CLIENT=
